generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  phone        String        @unique
  email        String?       @unique
  name         String
  qualification String?
  occupation    String?
  role         String        @default("SEEKER")
  isVerified         Boolean             @default(false)
  verificationLevel  Int                 @default(0) // 0, 1, 2, 3
  verificationStatus String              @default("NONE") // NONE, PENDING, VERIFIED, REJECTED
  businessProfile    BusinessProfile?
  reviewsReceived    Review[]            @relation("EmployerReviews")
  verificationRequests VerificationRequest[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  jobsPosted   Job[]         @relation("EmployerJobs")
  applications Application[]
}

model BusinessProfile {
  id           String  @id @default(uuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id])
  shopName     String
  businessType String
  address      String
  gstNumber    String?
  lat          Float?
  lng          Float?
  storePhoto   String?
}

model VerificationRequest {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  type           String   // PHONE, DOCUMENT, GST
  documentUrl    String?
  status         String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNotes     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Review {
  id         String   @id @default(uuid())
  employerId String
  employer   User     @relation("EmployerReviews", fields: [employerId], references: [id])
  seekerId   String
  rating     Int      // 1-5
  comment    String?
  createdAt  DateTime @default(now())
}

model Job {
  id           String        @id @default(uuid())
  title        String
  category     String
  salary       String
  salaryMin    Float?
  salaryMax    Float?
  location     String
  lat          Float?
  lng          Float?
  workingHours String
  description  String?
  requiredDocs String?
  minQualification String? @default("Not Needed")
  minExperience    String? @default("Not Needed")
  isFlagged    Boolean       @default(false)
  views        Int           @default(0)
  employerId   String
  employer     User          @relation("EmployerJobs", fields: [employerId], references: [id])
  reports      JobReport[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
}

model JobReport {
  id         String   @id @default(uuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id])
  reporterId String
  reason     String
  details    String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
}

model Application {
  id         String   @id @default(uuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id])
  seekerId   String
  seeker     User     @relation(fields: [seekerId], references: [id])
  skills     String?
  experience String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([jobId, seekerId])
}
